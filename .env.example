# 复制为 .env.local 在本地开发使用
# Vercel 部署时这些值要填到 Project Settings → Environment Variables

# 可选：StepFun API key
# 留空 = 纯 preset 模式（仍然完整可用，只是分镜来自本地模板）
# 填了 = 仅显式请求 /api/cinema 时才尝试生成（消耗配额）。
# 当前 Web 主练习仍离线；原生 direct 仍离线，可选 AI 按开关和调用路径执行。
STEPFUN_API_KEY=

# 可选：StepFun 模型名（默认 step-3.7-flash）
# STEPFUN_MODEL=step-3.7-flash

# 可选：匿名产品事件。未配置时返回 202 + accepted:false，不代表已入库。
# 只接收固定白名单字段，不接收用户原话、反馈文字或精确事件时间。
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Expo 移动端使用的公开 Web/API 地址。匿名分析仍需用户在设置中主动开启。
EXPO_PUBLIC_STILLMIND_API_BASE_URL=
EXPO_PUBLIC_STILLMIND_WEB_BASE_URL=
