{
  "name": "stillmind-inner-cinema",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": {
      "decode-uri-component": "0.5.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:web": "eslint src packages test",
    "lint:mobile": "npm --workspace mobile run lint",
    "lint": "npm run lint:web && npm run lint:mobile",
    "typecheck:web": "tsc --noEmit",
    "typecheck:design": "tsc -p packages/design-tokens/tsconfig.json --noEmit",
    "typecheck:domain": "tsc -p packages/domain/tsconfig.json --noEmit",
    "typecheck:content": "tsc -p packages/content/tsconfig.json --noEmit",
    "typecheck:mobile": "tsc -p mobile/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:web && npm run typecheck:design && npm run typecheck:domain && npm run typecheck:content && npm run typecheck:mobile",
    "test:domain": "tsx --test packages/domain/test/routing.test.ts",
    "test:content": "tsx --test packages/content/test/catalog.test.ts",
    "test:api": "tsx --test test/api-cinema.test.ts",
    "test:api-events": "tsx --test test/api-events.test.ts",
    "test:analytics": "tsx --test test/analytics.test.ts",
    "test:timeline": "tsx --test test/timeline.test.ts",
    "test:seed-users": "tsx --test test/seed-users.test.ts",
    "test:device-qa": "tsx --test test/device-qa.test.ts",
    "test:reset-routing": "tsx --test test/reset-routing.test.ts test/reset-draft.test.ts test/web-library.test.ts",
    "test": "npm run test:domain && npm run test:content && npm run test:api && npm run test:api-events && npm run test:analytics && npm run test:timeline && npm run test:seed-users && npm run test:device-qa && npm run test:reset-routing && npm run test:payment-interviews && npm run test:audit && npm run test:native && npm run test:dependencies && npm run test:round2",
    "check:claims": "node scripts/check-public-claims.mjs",
    "check:eas": "node scripts/check-eas-config.mjs",
    "check:app-store": "node scripts/check-app-store-metadata.mjs",
    "check:gtm": "node scripts/check-gtm-readiness.mjs",
    "check:source-boundary": "node scripts/check-source-boundary.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs && npm run check:eas && npm run check:app-store && npm run check:gtm && npm run check:source-boundary",
    "status:launch": "node scripts/report-launch-status.mjs",
    "analyze:seed-users": "node scripts/summarize-seed-users.mjs",
    "analyze:device-qa": "node scripts/summarize-device-qa.mjs",
    "doctor:mobile": "npx expo-doctor@latest mobile",
    "build:mobile:ios": "cd mobile && npx expo export --platform ios --output-dir ../.expo-ci/ios --clear",
    "build:mobile:web": "cd mobile && npx expo export --platform web --output-dir ../.expo-ci/web --clear",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run check:claims && npm run build",
    "verify:release": "npm run verify && npm run check:release-readiness && npm run doctor:mobile && npm run build:mobile:ios && npm run build:mobile:web",
    "test:payment-interviews": "tsx --test test/payment-interviews.test.ts",
    "analyze:payment-interviews": "node scripts/summarize-payment-interviews.mjs",
    "test:audit": "tsx --test test/session-integrity.test.ts test/api-cinema-provider.test.ts && node --test test/claims-guard.test.mjs",
    "smoke:web": "node scripts/smoke-web.mjs && node scripts/smoke-adversarial.mjs",
    "postinstall": "node scripts/patch-query-string-cjs.mjs",
    "test:native": "tsx --test test/native-session.test.ts test/native-database.test.ts test/native-storage-lifecycle.test.ts test/native-pause-contract.test.mjs",
    "smoke:native": "node scripts/smoke-native-web.mjs",
    "smoke:states:web": "node scripts/run-experience-states.mjs",
    "smoke:states:native": "node scripts/run-experience-states.mjs --native",
    "smoke:product:web": "node scripts/smoke-product-paths.mjs",
    "smoke:product:native": "node scripts/smoke-product-paths.mjs --native",
    "test:dependencies": "node --test test/dependency-compat.test.mjs",
    "test:round2": "tsx --test test/round2-contracts.test.ts test/observation.test.ts test/request-policy.test.ts && node --test test/round2-seed.test.mjs"
  },
  "dependencies": {
    "@stillmind/content": "*",
    "@stillmind/design-tokens": "*",
    "@stillmind/domain": "*",
    "next": "16.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "expo": "~57.0.31",
    "expo-router": "~57.0.29",
    "react-native": "0.86.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
